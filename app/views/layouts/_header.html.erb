<div class="page-main-header">
  <div class="main-header-right row m-0">
    <div class="main-header-left">
      <div class="logo-wrapper">
        <%= link_to (current_company ? company_calendar_path(current_company) : companies_path), class: "d-flex align-items-center" do %>
          <h4 class="mb-0 ms-2" style="font-family: Inter, sans-serif; font-weight:800; color:#7366FF; letter-spacing:-0.5px;">Social Portal</h4>
        <% end %>
      </div>
      <div class="toggle-sidebar"><i class="status_toggle middle" data-feather="align-center" id="sidebar-toggle"></i></div>
    </div>
    <div class="left-menu-header col">
      <ul class="nav-menus m-0">
        <% companies = signed_in? ? accessible_companies.order(:name) : Company.none %>
        <% if companies.any? %>
          <li class="onhover-dropdown ps-3">
            <div class="d-flex align-items-center" style="cursor:pointer;">
              <span style="width:34px;height:34px;border-radius:8px;background:#7366FF1a;color:#7366FF;display:inline-flex;align-items:center;justify-content:center;font-weight:700;">
                <%= current_company ? current_company.name[0].upcase : "?" %>
              </span>
              <div class="ms-2 text-start">
                <span class="text-muted f-12 d-block lh-1">Company</span>
                <strong><%= current_company&.name || "Select a company" %></strong>
              </div>
              <i data-feather="chevron-down" class="ms-2" style="width:16px;height:16px;"></i>
            </div>
            <div class="onhover-show-div p-2" style="min-width:260px;max-height:60vh;overflow-y:auto;">
              <% companies.each do |c| %>
                <%= button_to switch_company_path(c), method: :post,
                      class: "btn p-2 d-flex align-items-center w-100 text-start #{'bg-light' if c == current_company}",
                      form: { class: "d-block mb-1" } do %>
                  <span style="width:28px;height:28px;border-radius:6px;background:#7366FF;color:white;display:inline-flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0;">
                    <%= c.name[0].upcase %>
                  </span>
                  <span class="ms-2 flex-grow-1"><%= c.name %></span>
                  <% if c == current_company %><i data-feather="check" style="width:16px;height:16px;color:#7366FF;"></i><% end %>
                <% end %>
              <% end %>
              <% if current_user.admin? %>
                <hr class="my-2">
                <%= link_to "+ New company", new_company_path, class: "btn btn-sm btn-primary w-100" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
    <div class="nav-right col pull-right right-menu p-0">
      <ul class="nav-menus">
        <li class="onhover-dropdown">
          <div class="d-flex align-items-center" style="cursor:pointer;">
            <div style="width:32px;height:32px;border-radius:50%;background:#7366FF;color:white;display:flex;align-items:center;justify-content:center;font-weight:600;">
              <%= current_user&.display_name&.first&.upcase %>
            </div>
            <span class="ms-2 d-none d-md-inline"><%= current_user&.display_name %></span>
          </div>
          <ul class="profile-dropdown onhover-show-div">
            <li><span class="text-muted small px-2"><%= current_user&.email %></span></li>
            <li><hr class="my-1"></li>
            <li><%= button_to "Sign out", logout_path, method: :delete, class: "btn btn-link text-danger p-0", form: { class: "d-inline" } %></li>
          </ul>
        </li>
      </ul>
    </div>
    <div class="d-lg-none mobile-toggle pull-right w-auto"><i data-feather="more-horizontal"></i></div>
  </div>
</div>
