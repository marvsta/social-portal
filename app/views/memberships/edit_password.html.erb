<% content_for :title, "Set password" %>
<div class="container-fluid">
  <div class="page-header">
    <h3>Set password for <%= @user.display_name %></h3>
    <p class="text-muted mb-0"><%= @user.email %> · Their existing sessions will be signed out, and you'll need to share the new password with them securely.</p>
  </div>

  <div class="row">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-body">
          <%= form_with url: update_password_company_membership_path(@company, @membership), method: :patch, local: true do %>
            <div class="mb-3">
              <label class="form-label" for="user_password">New password</label>
              <%= password_field_tag "user[password]", nil, id: "user_password", class: "form-control", required: true, minlength: 8, autocomplete: "new-password" %>
              <small class="text-muted">At least 8 characters.</small>
            </div>
            <div class="mb-3">
              <label class="form-label" for="user_password_confirmation">Confirm new password</label>
              <%= password_field_tag "user[password_confirmation]", nil, id: "user_password_confirmation", class: "form-control", required: true, minlength: 8, autocomplete: "new-password" %>
            </div>
            <%= submit_tag "Set password", class: "btn btn-primary" %>
            <%= link_to "Cancel", company_memberships_path(@company), class: "btn btn-link" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
