<% content_for :title, "Companies" %>
<div class="container-fluid">
  <div class="page-header">
    <div class="row">
      <div class="col-sm-6">
        <h3><%= current_user.admin? ? "All companies" : "Your companies" %></h3>
        <p class="text-muted mb-0">
          <%= current_user.admin? ? "You're a platform admin — every company on the platform is listed here." : "Pick a company to open." %>
        </p>
      </div>
      <div class="col-sm-6 text-end">
        <% if current_user.admin? %>
          <%= link_to new_company_path, class: "btn btn-primary" do %>
            <i data-feather="plus"></i>&nbsp; New company
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @companies.empty? %>
    <div class="card">
      <div class="card-body text-center p-5">
        <i data-feather="briefcase" style="width:48px;height:48px;color:#7366FF"></i>
        <h5 class="mt-3">You're not part of any company yet</h5>
        <p class="text-muted mb-0">Ask your platform admin to add you to a company, then it will show up here.</p>
      </div>
    </div>
  <% else %>
    <div class="row">
      <% @companies.each do |company| %>
        <div class="col-md-4 mb-4">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title mb-1"><%= company.name %></h5>
              <p class="text-muted mb-3"><%= company.website.presence || "No website set" %></p>
              <p class="mb-2 small">
                <i data-feather="users" class="me-1"></i> <%= pluralize(company.users.count, "member") %>
                &nbsp; <i data-feather="share-2" class="me-1"></i> <%= pluralize(company.social_channels.count, "channel") %>
                &nbsp; <i data-feather="edit-3" class="me-1"></i> <%= pluralize(company.posts.count, "post") %>
              </p>
              <div class="d-flex gap-2">
                <%= link_to "Open", company_calendar_path(company), class: "btn btn-primary btn-sm" %>
                <% if current_user.admin? || current_user.role_in(company) == "owner" %>
                  <%= link_to "Settings", edit_company_path(company), class: "btn btn-outline-secondary btn-sm" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
